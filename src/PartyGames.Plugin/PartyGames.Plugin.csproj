<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.6.2.0</Version>
    <AssemblyName>PartyGames</AssemblyName>
    <RootNamespace>PartyGames</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PartyGames.Protocol\PartyGames.Protocol.csproj" />
  </ItemGroup>

  <!-- 默认背景图嵌入 DLL，避免因文件路径问题加载不到 -->
  <ItemGroup>
    <EmbeddedResource Include="assets\default-bg.png">
      <LogicalName>default-bg.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 珊瑚音色的语音片段，随插件一起发布 -->
  <ItemGroup>
    <Content Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="audio\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
