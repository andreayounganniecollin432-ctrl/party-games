<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.6.5.5</Version>
    <AssemblyName>PartyGames</AssemblyName>
    <RootNamespace>PartyGames</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PartyGames.Protocol\PartyGames.Protocol.csproj" />
  </ItemGroup>

  <!-- 液化玻璃：Glasswork 的玻璃材质 + Look 主题 -->
  <ItemGroup>
    <PackageReference Include="Glasswork" Version="0.1.0-beta.5" />
    <PackageReference Include="Glasswork.Glass" Version="0.1.0-beta.5" />
    <PackageReference Include="Glasswork.Backend" Version="0.1.0-beta.5" />
    <PackageReference Include="Glasswork.Dalamud" Version="0.1.0-beta.5" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 默认背景图嵌入 DLL，避免因文件路径问题加载不到 -->
  <ItemGroup>
    <EmbeddedResource Include="assets\default-bg.png">
      <LogicalName>default-bg.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 珊瑚音色的语音片段，随插件一起发布 -->
  <ItemGroup>
    <Content Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="audio\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
